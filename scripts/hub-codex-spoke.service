# Template: keep the Codex spoke (`hub codex-spoke serve`) running on Linux (systemd user unit).
# The spoke attaches to the shared Codex app-server daemon's threads (CODEX_HOME/app-server-control, read only) for the
# hub and starts its own `codex app-server` (HUB_CODEX_BIN, else codex on the PATH below) for hub launches. `hub codex`
# starts it on demand; this unit keeps it running so launches can be placed here without a `hub codex` run first. It
# needs an enrolled machine (the plugin's /hub dialog writes the machine token to ~/.config/hub/config.json, which the
# spoke only reads). HUB_CODEX_CONFIG is not carried in: add it below by hand.
# Install: `hub codex-spoke install` writes this unit to ~/.config/systemd/user with the real paths and prints the
# systemctl commands to enable it; it never runs them (--dry-run: only print).
# By hand (replace __RUNTIME__, __ENTRY__ and __HOME__ first):
#   mkdir -p ~/.config/systemd/user
#   sed -e "s|__RUNTIME__|$HOME/.bun/bin/bun|" -e "s|__ENTRY__|$PWD/packages/cli/src/main.ts|" -e "s|__HOME__|$HOME|g" \
#     scripts/hub-codex-spoke.service > ~/.config/systemd/user/hub-codex-spoke.service
#   systemctl --user daemon-reload && systemctl --user enable --now hub-codex-spoke
# Logs: journalctl --user -u hub-codex-spoke
# Remove: `hub codex-spoke uninstall`, or systemctl --user disable --now hub-codex-spoke && rm the unit file
# BUN_BE_BUN=1 lets an OpenCode binary act as bun; the CLI removes it from its own environment.
[Unit]
Description=Hub Codex spoke (follows Codex threads, starts hub launches)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__RUNTIME__ __ENTRY__ codex-spoke serve
Environment=PATH=__HOME__/.local/bin:__HOME__/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=BUN_BE_BUN=1
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=default.target
