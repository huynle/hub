{
  "name": "@huynle/opencode-hub",
  "version": "0.5.0",
  "description": "A remote console for your OpenCode sessions: follow, steer and stop sessions from your phone or browser, with optional hands-free Voice and a self-hostable hub.",
  "license": "MIT",
  "author": "Huy Le",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huynle/opencode-hub.git"
  },
  "homepage": "https://github.com/huynle/opencode-hub#readme",
  "bugs": {
    "url": "https://github.com/huynle/opencode-hub/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "hub",
    "remote",
    "console",
    "voice",
    "speech",
    "tts",
    "stt",
    "pwa",
    "agent"
  ],
  "type": "module",
  "main": "./server.ts",
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./tui": "./tui.ts",
    "./rpc": "./rpc.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "opencode-hub": "bin/hub.ts",
    "opencode-voice-hub": "bin/hub.ts"
  },
  "files": [
    "server.ts",
    "tui.ts",
    "rpc.ts",
    "src",
    "bin",
    "web",
    "docker",
    "Dockerfile",
    "scripts/hub-local.sh",
    "scripts/com.opencode-hub.hub.plist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "hub": "bun bin/hub.ts"
  },
  "dependencies": {
    "@opencode/client": "^2.0.26",
    "@opencode/plugin": "^2.0.26",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  }
}
