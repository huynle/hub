{
  "name": "@huynle/hub",
  "version": "0.6.1",
  "description": "Hub: a harness-agnostic central hub your AI agent harnesses connect to (OpenCode first). Follow, steer and stop sessions from your phone or browser, with notifications, optional hands-free Voice and a self-hostable server.",
  "license": "MIT",
  "author": "Huy Le",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huynle/hub.git"
  },
  "homepage": "https://github.com/huynle/hub#readme",
  "bugs": {
    "url": "https://github.com/huynle/hub/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "hub",
    "remote",
    "console",
    "voice",
    "speech",
    "tts",
    "stt",
    "pwa",
    "agent",
    "harness"
  ],
  "type": "module",
  "main": "./server.ts",
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./tui": "./tui.ts",
    "./rpc": "./rpc.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "hub-server": "bin/hub.ts",
    "opencode-hub": "bin/hub.ts",
    "opencode-voice-hub": "bin/hub.ts"
  },
  "files": [
    "server.ts",
    "tui.ts",
    "rpc.ts",
    "src",
    "packages/protocol/src",
    "packages/protocol/package.json",
    "bin",
    "web/dist",
    "docker",
    "Dockerfile",
    "scripts/hub-local.sh",
    "scripts/io.github.huynle.hub.plist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/protocol",
    "packages/cli"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test:e2e": "bun web/e2e/smoke.ts",
    "prepack": "npm run build:web",
    "hub": "bun bin/hub.ts"
  },
  "dependencies": {
    "@opencode/client": "^2.0.26",
    "@opencode/plugin": "^2.0.26",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/web-push": "^3.6.4",
    "onnxruntime-web": "1.23.2",
    "playwright-core": "^1.64.1",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
