{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["server.ts", "tui.ts", "rpc.ts", "src", "test", "bin", "web/e2e", "packages/protocol/src", "packages/protocol/test", "packages/cli/src", "packages/cli/test"]
}
